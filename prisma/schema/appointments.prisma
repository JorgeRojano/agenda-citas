//////////////////////
// USER / PROFILE
//////////////////////

model Profile {
  id         String    @id
  role       UserRole  @default(USER)
  email      String?
  name       String?
  specialty  String?
  isResource Boolean   @default(false)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  appointments      Appointment[]
  resourceVacations ResourceVacation[]
  services          ServiceResource[]
  resourceTimeSlots ResourceTimeSlot[]

  createdAt DateTime @default(now())

  @@map("profiles")
}

//////////////////////
// BUSINESS IMAGE
//////////////////////

model BusinessImage {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([businessId, order])
}

//////////////////////
// BUSINESS TIME
//////////////////////

model BusinessTimeSlot {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, dayOfWeek])
}

//////////////////////
// RESOURCE TIME
//////////////////////

model ResourceTimeSlot {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String

  @@index([profileId])
}

//////////////////////
// RESOURCE VACATION
//////////////////////

model ResourceVacation {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String?
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  @@index([profileId])
}

//////////////////////
// SERVICES
//////////////////////

model Service {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  duration  Int
  price     Int
  showPrice Boolean @default(true)

  appointments Appointment[]
  resources    ServiceResource[]

  createdAt DateTime @default(now())

  @@index([businessId])
}

//////////////////////
// SERVICERESOURCE
//////////////////////

model ServiceResource {
  serviceId String
  profileId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([serviceId, profileId])
}

//////////////////////
// APPOINTMENTS
//////////////////////

model Appointment {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   Profile? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  clientName String
  phone      String

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([startTime])
  @@index([status])
}

//////////////////////
// BLOCKED TIMES
//////////////////////

model BlockedTime {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String?
  start      DateTime
  end        DateTime
  createdAt  DateTime @default(now())

  @@index([businessId])
}
