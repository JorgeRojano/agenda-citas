generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

//////////////////////
// USER / PROFILE
//////////////////////

model Profile {
  id   String   @id
  role UserRole @default(USER)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("profiles")
}

//////////////////////
// BUSINESS (TENANT)
//////////////////////

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String?
  createdAt DateTime @default(now())

  services     Service[]
  appointments Appointment[]
  blockedTimes BlockedTime[]
  users        Profile[]

  schedule BusinessSchedule?

  @@index([slug])
}

//////////////////////
// BUSINESS SCHEDULE
//////////////////////

model BusinessSchedule {
  id String @id @default(uuid())

  businessId String  @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Closing days (0-6) -> 0 = Sunday
  closedDays Int[]

  // General Opening Time (optional)
  openTime  String? // "09:00"
  closeTime String? // "18:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////
// SERVICES
//////////////////////

model Service {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  duration Int // minutos
  price    Int // en centavos para evitar floats

  appointments Appointment[]

  createdAt DateTime @default(now())

  @@index([businessId])
}

//////////////////////
// APPOINTMENTS
//////////////////////

model Appointment {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  clientName String
  phone      String

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([startTime])
  @@index([status])
}

//////////////////////
// BLOCKED TIMES
//////////////////////

model BlockedTime {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  start DateTime
  end   DateTime

  createdAt DateTime @default(now())

  @@index([businessId])
}
