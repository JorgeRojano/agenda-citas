generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

//////////////////////
// USER / PROFILE
//////////////////////

model Profile {
  id    String   @id
  role  UserRole @default(USER)
  email String?
  name      String?
  specialty String?
  isResource Boolean @default(false)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  appointments Appointment[]

  createdAt DateTime @default(now())

  @@map("profiles")
}

//////////////////////
// BUSINESS (TENANT)
//////////////////////

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String?
  description String?

  primaryColor String? @default("#2563eb")
  logoUrl      String? // URL de Supabase Storage
  bannerUrl    String? // URL de Supabase Storage

  whatsapp  String?
  facebook  String?
  instagram String?
  website   String?

  createdAt DateTime @default(now())

  services     Service[]
  appointments Appointment[]
  blockedTimes BlockedTime[]
  users        Profile[]

  timeSlots BusinessTimeSlot[] 

  @@index([slug])
}

//////////////////////
// BUSINESS TIME
//////////////////////

model BusinessTimeSlot {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // 0 = Sunday, 6 = Saturday
  dayOfWeek Int

  startTime String // "09:00"
  endTime   String // "12:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, dayOfWeek])
}

//////////////////////
// SERVICES
//////////////////////

model Service {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  duration Int // minutos
  price    Int // en centavos para evitar floats

  showPrice Boolean @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())

  @@index([businessId])
}

//////////////////////
// APPOINTMENTS
//////////////////////

model Appointment {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   Profile? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  clientName String
  phone      String

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([startTime])
  @@index([status])
}

//////////////////////
// BLOCKED TIMES
//////////////////////

model BlockedTime {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  start DateTime
  end   DateTime

  createdAt DateTime @default(now())

  @@index([businessId])
}
