generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

//////////////////////
// USER / PROFILE
//////////////////////

model Profile {
  id         String    @id
  role       UserRole  @default(USER)
  email      String?
  name       String?
  specialty  String?
  isResource Boolean   @default(false)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  appointments      Appointment[]
  resourceVacations ResourceVacation[]
  services          ServiceResource[]
  resourceTimeSlots ResourceTimeSlot[]

  createdAt DateTime @default(now())

  @@map("profiles")
}

//////////////////////
// BUSINESS (TENANT)
//////////////////////

model Business {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  phone       String?
  description String?

  primaryColor String? @default("blue")
  logoUrl      String?
  bannerUrl    String?

  hasStaff Boolean @default(false)

  address String?
  mapsUrl String?

  whatsapp  String?
  facebook  String?
  instagram String?
  website   String?

  createdAt DateTime @default(now())

  services     Service[]
  appointments Appointment[]
  blockedTimes BlockedTime[]
  users        Profile[]
  timeSlots    BusinessTimeSlot[]
  images       BusinessImage[]
  modules      BusinessModule[]

  @@index([slug])
}

//////////////////////
// BUSINESS IMAGE
//////////////////////

model BusinessImage {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([businessId, order])
}

//////////////////////
// BUSINESS TIME
//////////////////////

model BusinessTimeSlot {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String // "09:00"
  endTime   String // "12:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, dayOfWeek])
}

//////////////////////
// RESOURCE TIME
//////////////////////

model ResourceTimeSlot {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String

  @@index([profileId])
}

//////////////////////
// RESOURCE VACATION
//////////////////////

model ResourceVacation {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String?
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  @@index([profileId])
}

//////////////////////
// SERVICES
//////////////////////

model Service {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  duration  Int     // minutos
  price     Int     // en centavos para evitar floats
  showPrice Boolean @default(true)

  appointments Appointment[]
  resources    ServiceResource[]

  createdAt DateTime @default(now())

  @@index([businessId])
}

//////////////////////
// SERVICERESOURCE
//////////////////////

model ServiceResource {
  serviceId String
  profileId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([serviceId, profileId])
}

//////////////////////
// APPOINTMENTS
//////////////////////

model Appointment {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   Profile? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  clientName String
  phone      String

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([startTime])
  @@index([status])
}

//////////////////////
// MODULES
//////////////////////

model Module {
  id          String         @id @default(uuid())
  key         String         @unique
  name        String
  description String
  icon        String
  isAvailable Boolean        @default(true)
  createdAt   DateTime       @default(now())
  businesses  BusinessModule[]
}

// La asignación de módulos por negocio la gestiona el SUPER_ADMIN
// directamente en Supabase Table Editor → tabla BusinessModule
model BusinessModule {
  id          String   @id @default(uuid())
  businessId  String
  moduleKey   String
  isActive    Boolean  @default(true)
  settings    Json?
  activatedAt DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleKey], references: [key])

  @@unique([businessId, moduleKey])
  @@index([businessId])
}

//////////////////////
// BLOCKED TIMES
//////////////////////

model BlockedTime {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String?
  start      DateTime
  end        DateTime
  createdAt  DateTime @default(now())

  @@index([businessId])
}